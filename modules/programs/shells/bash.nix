{
  config,
  pkgs,
  lib,
  ...
}:
with lib; let
  cfg = config.programs.bash;

  # エイリアスマップを "alias foo='bar'" の複数行文字列に変換するヘルパー
  mkAliases = aliases:
    concatStringsSep "\n" (mapAttrsToList (k: v: "alias ${k}=${escapeShellArg v}") aliases);
in {
  options = {
    # ─── システム全体の設定 ───
    programs.bash = {
      enable = mkOption {
        type = types.bool;
        default = true;
        description = "Whether to enable bash.";
      };

      package = mkOption {
        type = types.package;
        default = pkgs.bashInteractive;
        description = "The package to use for bash.";
      };

      interactiveShellInit = mkOption {
        type = types.lines;
        default = "";
        description = "全ユーザー共通で /etc/bashrc の末尾に追加する初期化コード";
      };
    };

    # ─── ユーザーごとの設定 ───
    neet.users = mkOption {
      type = types.attrsOf (types.submodule ({
        name,
        config,
        ...
      }: let
        userCfg = config.programs.bash;
        hasConfig = userCfg.shellAliases != {} || userCfg.bashrcExtra != "";
      in {
        options.programs.bash = {
          shellAliases = mkOption {
            type = types.attrsOf types.str;
            default = {};
            example = {
              ll = "ls -la";
              gs = "git status";
            };
            description = "ユーザー '${name}' 専用の Bash エイリアス";
          };

          bashrcExtra = mkOption {
            type = types.lines;
            default = "";
            description = "ユーザー '${name}' の ~/.bashrc の末尾に追加するスクリプト";
          };
        };

        config = mkIf hasConfig {
          # ★ ユーザーの ~/.bashrc を生成
          files.".bashrc".text = ''
            # ~/.bashrc: generated by NEET_OS

            # システム全体の /etc/bashrc を読み込み
            if [ -r /etc/bashrc ]; then
              . /etc/bashrc
            fi

            # ユーザー固有エイリアス
            ${mkAliases userCfg.shellAliases}

            # ユーザー固有スクリプト
            ${userCfg.bashrcExtra}
          '';
        };
      }));
    };
  };

  config = mkIf cfg.enable {
    environment.systemPackages = [cfg.package];
    environment.shells = [cfg.package];

    environment.etc."profile.d/bash.sh".text = ''
      if [ -n "''${BASH_VERSION:-}" ] && [ -r /etc/bashrc ]; then
        . /etc/bashrc
      fi
    '';

    environment.etc."bashrc".text = ''
      # /etc/bashrc: system-wide interactive bash config
      if [ -n "$PS1" ]; then
        shopt -s checkwinsize
        set +h

        if [ "$TERM" != "dumb" ] || [ -n "$INSIDE_EMACS" ]; then
          PROMPT_COLOR="1;31m"
          ((UID)) && PROMPT_COLOR="1;32m"
          if [ -n "$INSIDE_EMACS" ]; then
            PS1="\n\[\033[$PROMPT_COLOR\][\u@\h:\w]\\$\[\033[0m\] "
          else
            PS1="\n\[\033[$PROMPT_COLOR\][\[\e]0;\u@\h: \w\a\]\u@\h:\w]\\$\[\033[0m\] "
          fi
          if test "$TERM" = "xterm"; then
            PS1="\[\033]2;\h:\u:\w\007\]$PS1"
          fi
        fi

        eval "$(${pkgs.coreutils}/bin/dircolors -b)"
        alias ls='ls --color=auto'
      fi

      ${cfg.interactiveShellInit}
    '';
  };
}
