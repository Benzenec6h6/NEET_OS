{
  config,
  pkgs,
  lib,
  ...
}:
with lib; let
  cfg = config.programs.zsh;

  mkAliases = aliases:
    concatStringsSep "\n" (mapAttrsToList (k: v: "alias ${k}=${escapeShellArg v}") aliases);

  anyUserHasZsh = any (u: u.programs.zsh.enable) (attrValues config.neet.users);
  isEnabled = cfg.enable || anyUserHasZsh;
in {
  options = {
    # ─── システム全体の設定 ───
    programs.zsh = {
      enable = mkOption {
        type = types.bool;
        default = false;
        description = "Whether to enable zsh system-wide.";
      };

      package = mkOption {
        type = types.package;
        default = pkgs.zsh;
        description = "The package to use for zsh.";
      };

      interactiveShellInit = mkOption {
        type = types.lines;
        default = "";
        description = "全ユーザー共通で /etc/zshrc の末尾に追加する初期化コード";
      };
    };

    # ─── ユーザーごとの設定 ───
    neet.users = mkOption {
      type = types.attrsOf (types.submodule ({
        name,
        config,
        ...
      }: let
        userCfg = config.programs.zsh;
        hasConfig = userCfg.enable && (userCfg.shellAliases != {} || userCfg.zshrcExtra != "");
      in {
        options.programs.zsh = {
          enable = mkEnableOption "Zsh for user '${name}'";

          shellAliases = mkOption {
            type = types.attrsOf types.str;
            default = {};
            example = {
              ll = "ls -la";
              gst = "git status";
            };
            description = "ユーザー '${name}' 専用の Zsh エイリアス";
          };

          zshrcExtra = mkOption {
            type = types.lines;
            default = "";
            description = "ユーザー '${name}' の ~/.zshrc の末尾に追加するスクリプト";
          };
        };

        config = mkIf hasConfig {
          # ★ ユーザーの ~/.zshrc を生成
          files.".zshrc".text = ''
            # ~/.zshrc: generated by NEET_OS

            # ユーザー固有エイリアス
            ${mkAliases userCfg.shellAliases}

            # ユーザー固有スクリプト
            ${userCfg.zshrcExtra}
          '';
        };
      }));
    };
  };

  config = mkIf isEnabled {
    environment.systemPackages = [cfg.package];
    environment.shells = [cfg.package];

    environment.etc."zprofile".text = ''
      if [ -r /etc/profile ]; then
        emulate sh -c '. /etc/profile'
      fi
    '';

    environment.etc."zshrc".text = ''
      # /etc/zshrc: system-wide interactive zsh config
      fpath=(
        /run/current-system/sw/share/zsh/site-functions
        /run/current-system/sw/share/zsh/$ZSH_VERSION/functions
        $fpath
      )

      autoload -Uz compinit
      compinit -u

      autoload -Uz promptinit
      promptinit
      PROMPT='%F{green}[%n@%m:%~]%#%f '

      HISTSIZE=10000
      SAVEHIST=10000
      setopt HIST_IGNORE_DUPS
      setopt SHARE_HISTORY

      eval "$(${pkgs.coreutils}/bin/dircolors -b)"
      alias ls='ls --color=auto'

      ${cfg.interactiveShellInit}
    '';
  };
}
