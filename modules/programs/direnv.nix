{
  config,
  pkgs,
  lib,
  ...
}:
with lib; let
  cfg = config.programs.direnv;
  tomlFormat = pkgs.formats.toml {};

  anyUserEnabled = cfg.enable || any (u: u.programs.direnv.enable) (attrValues config.neet.users);
in {
  options = {
    # ─── システム共通設定 ───
    programs.direnv = {
      enable = mkEnableOption "direnv environment switcher";

      package = mkOption {
        type = types.package;
        default = pkgs.direnv;
        defaultText = literalExpression "pkgs.direnv";
        description = "使用する direnv パッケージ";
      };

      silent = mkOption {
        type = types.bool;
        default = false;
        description = "direnv のログ出力を抑制するかどうか";
      };

      direnvrcExtra = mkOption {
        type = types.lines;
        default = "";
        description = "システム全体の direnvrc に追記するスクリプト";
      };

      loadInNixShell = mkOption {
        type = types.bool;
        default = true;
        description = "nix-shell / nix develop 内部でも direnv をロードするかどうか";
      };

      nix-direnv = {
        enable = mkOption {
          type = types.bool;
          default = true;
          description = "nix-direnv (use_nix / use_flake の高速化) を有効にするか";
        };

        package = mkOption {
          type = types.package;
          default = pkgs.nix-direnv;
          defaultText = literalExpression "pkgs.nix-direnv";
          description = "使用する nix-direnv パッケージ";
        };
      };
    };

    # ─── ユーザーごとの設定 ───
    neet.users = mkOption {
      type = types.attrsOf (types.submodule ({
        name,
        config,
        ...
      }: let
        userCfg = config.programs.direnv;
        hasDirenvrc = userCfg.direnvrcExtra != "";
        hasSettings = userCfg.settings != {};
      in {
        options.programs.direnv = {
          enable = mkOption {
            type = types.bool;
            default = cfg.enable && config.isSessionUser;
            description = "ユーザー '${name}' で direnv を有効にするか";
          };

          direnvrcExtra = mkOption {
            type = types.lines;
            default = "";
            description = "ユーザー固有の ~/.config/direnv/direnvrc に追記するスクリプト";
          };

          settings = mkOption {
            type = tomlFormat.type;
            default = {};
            description = "ユーザー固有の direnv 設定 (~/.config/direnv/direnv.toml)";
            example = literalExpression ''
              {
                global.load_dotenv = true;
                whitelist.prefix = [ "~/dev" ];
              }
            '';
          };
        };

        config = mkIf userCfg.enable {
          xdg.configFile = {
            "direnv/direnvrc" = mkIf hasDirenvrc {
              text = userCfg.direnvrcExtra;
            };
            "direnv/direnv.toml" = mkIf hasSettings {
              source = tomlFormat.generate "direnv.toml" userCfg.settings;
            };
          };
        };
      }));
    };
  };

  config = mkIf anyUserEnabled {
    environment.systemPackages =
      [cfg.package]
      ++ optional cfg.nix-direnv.enable cfg.nix-direnv.package;

    environment.variables =
      {
        DIRENV_CONFIG = "/etc/direnv";
      }
      // optionalAttrs cfg.silent {
        DIRENV_LOG_FORMAT = "";
      };

    # システム全体の direnvrc
    environment.etc."direnv/direnvrc".text = ''
      # --- System-wide direnvrc generated by NEET_OS ---

      # nix-direnv の gcroots を一箇所に集約
      : ''${NIX_DIRENV_ROOT:="$HOME/.local/share/direnv/gcroots"}

      ${optionalString cfg.nix-direnv.enable ''
        # Load nix-direnv
        source ${cfg.nix-direnv.package}/share/nix-direnv/direnvrc
      ''}

      ${cfg.direnvrcExtra}

      # ユーザー固有の direnvrc が存在する場合は続けて読み込む
      if [ -f "$HOME/.config/direnv/direnvrc" ]; then
        source "$HOME/.config/direnv/direnvrc"
      elif [ -f "$HOME/.direnvrc" ]; then
        source "$HOME/.direnvrc"
      fi
    '';

    # Bash フック
    programs.bash.interactiveShellInit = ''
      ${optionalString (!cfg.loadInNixShell) "if [ -z \"$IN_NIX_SHELL\" ]; then"}
        eval "$(${getExe cfg.package} hook bash)"
      ${optionalString (!cfg.loadInNixShell) "fi"}
    '';

    # Zsh フック
    programs.zsh.interactiveShellInit = ''
      ${optionalString (!cfg.loadInNixShell) "if [ -z \"$IN_NIX_SHELL\" ]; then"}
        eval "$(${getExe cfg.package} hook zsh)"
      ${optionalString (!cfg.loadInNixShell) "fi"}
    '';
  };
}
