{
  config,
  pkgs,
  lib,
  ...
}: let
  cfg = config.programs.direnv;
in {
  options.programs.direnv = {
    enable = lib.mkEnableOption "direnv environment switcher";

    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.direnv;
      defaultText = lib.literalExpression "pkgs.direnv";
      description = "The direnv package to use.";
    };

    silent = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Whether to suppress direnv logging.";
    };

    direnvrcExtra = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Extra lines to append to system-wide direnvrc.";
    };

    loadInNixShell = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Whether to load direnv in nix-shell / nix develop environments.";
    };

    nix-direnv = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Whether to enable nix-direnv for fast and persistent use_nix/use_flake.";
      };

      package = lib.mkOption {
        type = lib.types.package;
        default = pkgs.nix-direnv;
        defaultText = lib.literalExpression "pkgs.nix-direnv";
        description = "The nix-direnv package to use.";
      };
    };
  };

  config = lib.mkIf cfg.enable {
    environment.systemPackages =
      [
        cfg.package
      ]
      ++ lib.optional cfg.nix-direnv.enable cfg.nix-direnv.package;

    # direnv にシステム共通の direnvrc ディレクトリを認識させる
    environment.variables =
      {
        DIRENV_CONFIG = "/etc/direnv";
      }
      // lib.optionalAttrs cfg.silent {
        DIRENV_LOG_FORMAT = "";
      };

    # システム全体の direnvrc
    environment.etc."direnv/direnvrc".text = ''
      # --- System-wide direnvrc generated by NEET_OS ---

      # Load nix-direnv
      source ${cfg.nix-direnv.package}/share/nix-direnv/direnvrc

      # nix-direnv の gcroots を一箇所に集約（保護・削除のコントロールを容易にする）
      : ''${NIX_DIRENV_ROOT:="$HOME/.local/share/direnv/gcroots"}

      ${lib.optionalString cfg.nix-direnv.enable ''
        # Load nix-direnv
        source ${cfg.nix-direnv.package}/share/nix-direnv/direnvrc
      ''}

      ${cfg.direnvrcExtra}

      # ユーザー固有の direnvrc が存在する場合は続けて読み込む
      if [ -f "$HOME/.config/direnv/direnvrc" ]; then
        source "$HOME/.config/direnv/direnvrc"
      elif [ -f "$HOME/.direnvrc" ]; then
        source "$HOME/.direnvrc"
      fi
    '';

    # --- 各シェルへのフック注入 ---

    # Bash
    programs.bash.interactiveShellInit = ''
      ${lib.optionalString (!cfg.loadInNixShell) ''
        if [ -z "$IN_NIX_SHELL" ]; then
      ''}
        eval "$(${lib.getExe cfg.package} hook bash)"
      ${lib.optionalString (!cfg.loadInNixShell) ''
        fi
      ''}
    '';

    # Zsh
    programs.zsh.interactiveShellInit = ''
      ${lib.optionalString (!cfg.loadInNixShell) ''
        if [ -z "$IN_NIX_SHELL" ]; then
      ''}
        eval "$(${lib.getExe cfg.package} hook zsh)"
      ${lib.optionalString (!cfg.loadInNixShell) ''
        fi
      ''}
    '';
  };
}
