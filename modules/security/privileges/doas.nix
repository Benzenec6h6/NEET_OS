{
  config,
  lib,
  pkgs,
  ...
}: let
  privCfg = config.neet.security.privileges;
  cfg = config.neet.security.doas;
  isBackend = privCfg.backend == "doas";
in {
  options.neet.security.doas = {
    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.doas;
      description = "使用する doas パッケージ";
    };

    wheelPersist = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "wheel グループのパスワード認証を一定時間キャッシュ (persist) するかどうか";
    };
  };

  config = lib.mkIf isBackend {
    neet.security.privileges.command = "/run/wrappers/bin/doas";

    # ★ persist が有効な場合のみ、タイムスタンプ用のランタイムディレクトリを確保
    system.stateDirectories = lib.optionals cfg.wheelPersist [
      {
        path = "/run/doas";
        mode = "0700";
        user = "root";
        group = "root";
      }
    ];

    environment.etc."doas.conf" = {
      mode = "0400";
      source = let
        rulesText =
          lib.concatMapStringsSep "\n" (
            rule: let
              asTarget =
                if rule.runAs == "ALL" || rule.runAs == "*"
                then ""
                else " as ${rule.runAs}";
              nopass = lib.optionalString (!rule.requirePassword) "nopass ";
              cmdStr =
                if rule.command == "ALL"
                then ""
                else " cmd ${rule.command}" + lib.optionalString (rule.args != "") " args ${rule.args}";
              ruleLine = id: "permit ${nopass}setenv { TERMINFO } ${id}${asTarget}${cmdStr}";
            in ''
              ${lib.concatMapStringsSep "\n" (u: ruleLine (toString u)) rule.users}
              ${lib.concatMapStringsSep "\n" (g: ruleLine ":${toString g}") rule.groups}
            ''
          )
          privCfg.rules;

        # wheel のフラグ組み立て:
        # nopass の場合は persist は無意味なので付与せず、パスワード必須かつ wheelPersist の時だけ "persist " を付与
        wheelOpts = lib.concatStringsSep " " (
          lib.optional (!privCfg.wheelNeedsPassword) "nopass"
          ++ lib.optional (privCfg.wheelNeedsPassword && cfg.wheelPersist) "persist"
        );
        wheelPrefix =
          if wheelOpts != ""
          then "${wheelOpts} "
          else "";

        rawContent = ''
          # Generated by NEET_OS (doas backend)
          # keepenv を外し、TERMINFO のみ保持を許可する
          permit ${wheelPrefix}setenv { TERMINFO } :wheel
          ${rulesText}
        '';
      in
        pkgs.runCommand "doas.conf-validated" {
          src = pkgs.writeText "doas.conf.in" rawContent;
        } ''
          ${pkgs.buildPackages.doas}/bin/doas -C $src && cp $src $out
        '';
    };

    neet.security.wrappers.doas = {
      source = "${cfg.package}/bin/doas";
      setuid = true;
      owner = "root";
      group = "root";
    };

    environment.systemPackages = [cfg.package];
  };
}
