#!@execline@/bin/execlineb -P
export PATH @systemPath@/bin:@systemPath@/sbin
fdmove -c 2 1
foreground { echo "[stage2] Starting stage2 init sequence..." }

# ここで /etc と /run を含む各種マウントを組み立てる (system-init 経由)
foreground { echo "[stage2] Running activation script (system-init)..." }
if { @systemInitBin@ @etcPackage@ @systemPath@ @kernelPath@ @firmwarePackage@ }
foreground { echo "[stage2] Activation done." }

# /run のマウントが完了した後で、s6-rc 用のディレクトリを作る
foreground { mkdir -p /run/service }

# -------------------------------------------------------------
# 同期用パイプの作成: fd 3 = 読み取り端, fd 4 = 書き込み端
# -------------------------------------------------------------
piperw 3 4

background
{
  # [子プロセス] 書き込み用 fd 4 は使わないので閉じる
  fdclose 4
  fdmove -c 2 1
  foreground { echo "[stage2-bg] Waiting for s6-svscan..." }

  # fd 3 から1文字/1行が送られてくるまで待機
  # (標準入力を fd 3 に向け、head -n 1 で1行読み捨ててブロック解除)
  foreground { fdmove 0 3 head -n 1 }
  fdclose 3

  foreground { echo "[stage2-bg] Running s6-rc-init..." }
  if { s6-rc-init -c /etc/s6-rc/compiled /run/service }
  foreground { echo "[stage2-bg] Changing state to top..." }
  s6-rc -u change top
}

# [親プロセス] 読み取り用 fd 3 は使わないので閉じる
fdclose 3
foreground { echo "[stage2] Executing s6-svscan..." }

# -d 4 を指定して s6-svscan に exec
# 準備完了時に s6-svscan が fd 4 に '\n' を書き込み、バックグラウンドが即座に起床する
s6-svscan -d 4 /run/service
